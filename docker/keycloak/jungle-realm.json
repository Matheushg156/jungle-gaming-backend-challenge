{
  "realm": "jungle",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "provider"
      },
      {
        "name": "operator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "wagering-api",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "demo-provider-a",
      "secret": "provider-a-local-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "provider-identity",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-provider-b",
      "secret": "provider-b-local-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "provider-identity",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-operator",
      "secret": "operator-local-secret",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-demo-provider-a",
      "enabled": true,
      "serviceAccountClientId": "demo-provider-a",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-demo-provider-b",
      "enabled": true,
      "serviceAccountClientId": "demo-provider-b",
      "realmRoles": ["provider"]
    },
    {
      "username": "service-account-demo-operator",
      "enabled": true,
      "serviceAccountClientId": "demo-operator",
      "realmRoles": ["operator"]
    }
  ]
}
