meta {
  name: 12 - Ledger primeira página
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/wallets/{{walletId}}/ledger?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("ledgerCursor", res.getBody().nextCursor);
  }
}

script:pre-request {
  const accessToken = bru.getEnvVar("operatorToken");
  if (typeof accessToken !== "string" || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(accessToken)) {
    throw new Error("Token ausente ou inválido: execute 03–05 no ambiente Local.local.");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resultado esperado", function () {
    expect(res.getBody().items).to.have.lengthOf(1);
    expect(res.getBody().nextCursor).to.be.a("string");
  });
}
