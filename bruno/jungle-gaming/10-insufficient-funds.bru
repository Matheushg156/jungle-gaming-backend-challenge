meta {
  name: 10 - BET de 80 com apenas 75
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/wagering/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{providerAToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: provider-a:{{runId}}:insufficient
  X-Correlation-Id: demo-{{runId}}
}

body:json {
  {
    "providerId": "provider-a",
    "externalTransactionId": "{{runId}}-insufficient",
    "playerId": "{{playerId}}",
    "walletId": "{{walletId}}",
    "roundId": "{{runId}}-round",
    "gameId": "demo-game",
    "kind": "BET",
    "money": {
      "amount": "80.00",
      "currency": "BRL"
    }
  }
}

tests {
  test("HTTP 422", function () {
    expect(res.getStatus()).to.equal(422);
  });
  test("Resultado esperado", function () {
    expect(res.getBody().failureCode).to.equal("INSUFFICIENT_FUNDS");
    expect(res.getBody().balance.amount).to.equal("75.00");
  });
}
