meta {
  name: 07 - BET de 25 BRL
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/wagering/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{providerAToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: provider-a:{{runId}}:bet
  X-Correlation-Id: demo-{{runId}}
}

body:json {
  {
    "providerId": "provider-a",
    "externalTransactionId": "{{runId}}-bet",
    "playerId": "{{playerId}}",
    "walletId": "{{walletId}}",
    "roundId": "{{runId}}-round",
    "gameId": "demo-game",
    "kind": "BET",
    "money": {
      "amount": "25.00",
      "currency": "BRL"
    }
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("transactionId", res.getBody().transactionId);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resultado esperado", function () {
    expect(res.getBody().balance.amount).to.equal("75.00");
    expect(res.getBody().idempotentReplay).to.equal(false);
  });
}
