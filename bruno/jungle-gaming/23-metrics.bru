meta {
  name: 23 - Métricas com operador
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/metrics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

script:pre-request {
  const accessToken = bru.getEnvVar("operatorToken");
  if (typeof accessToken !== "string" || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(accessToken)) {
    throw new Error("Token ausente ou inválido: execute 03–05 no ambiente Local.local.");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resultado esperado", function () {
    expect(res.getBody()).to.be.a("string");
    expect(res.getBody()).to.include("wager_transactions_total");
  });
}
