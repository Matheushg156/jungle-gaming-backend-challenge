meta {
  name: 02 - Readiness público
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resultado esperado", function () {
    expect(res.getBody().checks).to.deep.equal({postgres: "up", sqs: "up"});
  });
}

docs {
  Se retornar 503, confira PostgreSQL, LocalStack e as três filas. Não é necessário token.
}
