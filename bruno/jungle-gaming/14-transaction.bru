meta {
  name: 14 - Transação por ID interno
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/wagering/transactions/{{transactionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{providerAToken}}
}

script:pre-request {
  const accessToken = bru.getEnvVar("providerAToken");
  if (typeof accessToken !== "string" || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(accessToken)) {
    throw new Error("Token ausente ou inválido: execute 03–05 no ambiente Local.local.");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Resultado esperado", function () {
    expect(res.getBody().status).to.equal("PROCESSED");
    expect(res.getBody().providerId).to.equal("provider-a");
  });
}
