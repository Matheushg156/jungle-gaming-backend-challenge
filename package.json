{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering processor for the Jungle Gaming technical challenge",
  "scripts": {
    "test": "bun test tests",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "migration:up": "bun src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun src/infrastructure/persistence/migrate.ts down",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prometheus-io/client": "^0.16.1",
    "ajv": "8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/bun": "^1.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
